local function makeLabel(index: number, anchor: BasePart) : BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = "TradeTableIndexLabel"
	gui.Size = UDim2.fromOffset(100, 40)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.Adornee = anchor

	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Text = "Table " .. index
	text.TextScaled = true
	text.Font = Enum.Font.GothamBold
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0
	text.Parent = gui

	gui.Parent = anchor
	return gui
end

local function clearEntries()
	for _, entry in pairs(Entries) do
		if entry.highlight then entry.highlight:Destroy() end
		if entry.label then entry.label:Destroy() end
	end
	Entries = {}
end

function SetupTradeTableHighlights()
	clearEntries()

	for index, tbl in ipairs(getTradeTables()) do
		local anchor = tbl:FindFirstChild("P1") or tbl:FindFirstChildWhichIsA("BasePart", true)
		if anchor then
			local highlight = Instance.new("Highlight")
			highlight.Name = "DebugIndexHighlight"
			highlight.FillColor = COLORS[((index - 1) % #COLORS) + 1]
			highlight.OutlineColor = Color3.new(1, 1, 1)
			highlight.FillTransparency = 0.6
			highlight.OutlineTransparency = 0
			highlight.Adornee = tbl
			highlight.Parent = tbl

			local label = makeLabel(index, anchor)

			Entries[index] = { table = tbl, highlight = highlight, label = label }
		end
	end

	print(("Indexed %d trade table(s). Call HighlightTradeTable(<index>) to flash one."):format(#Entries))
end

-- Flash one specific table brighter than the rest for `duration` seconds
-- (default 3), e.g. HighlightTradeTable(2) to confirm which table index 2 is.
function HighlightTradeTable(index: number, duration: number?)
	local entry = Entries[index]
	if not entry then
		warn("No trade table at index " .. tostring(index))
		return
	end
	duration = duration or 3

	for i, e in pairs(Entries) do
		e.highlight.FillTransparency = (i == index) and 0.1 or 0.6
		e.highlight.OutlineTransparency = (i == index) and 0 or 0.5
	end

	task.delay(duration, function()
		for _, e in pairs(Entries) do
			if e.highlight then
				e.highlight.FillTransparency = 0.6
				e.highlight.OutlineTransparency = 0
			end
		end
	end)
end

function GetTradeTableByIndex(index: number) : Model?
	local entry = Entries[index]
	return entry and entry.table
end

