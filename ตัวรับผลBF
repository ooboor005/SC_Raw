function getIndices(dataTable, targetValue)
    local entries = {}

    for k, v in pairs(dataTable) do
        table.insert(entries, {index = k, value = v})
    end

    -- Sort highest → lowest
    table.sort(entries, function(a, b)
        return a.value > b.value
    end)

    local currentSum = 0
    local resultIndices = {}

    for i = 1, math.min(4, #entries) do
        local entry = entries[i]

        currentSum += entry.value
        table.insert(resultIndices, entry.index)

        -- ✅ NEW difference % logic
        local minValue = math.min(currentSum, targetValue)
        local maxValue = math.max(currentSum, targetValue, 0.01)
        local diffPercent = (1 - (minValue / maxValue)) * 100
        local result = math.ceil(diffPercent)

        print("Checking:", entry.index,
              "Value:", entry.value,
              "CurrentSum:", currentSum,
              "Diff%:", result)

        -- stop when trade becomes acceptable
        if result <= 40 then
            return resultIndices
        end
    end

    return resultIndices
end


