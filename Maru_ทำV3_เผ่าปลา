local function SwitchSword()
    local success, Inventory = pcall(function()
        return game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("getInventory")
    end)

    if not success or type(Inventory) ~= "table" then
        warn("[WEAPON] อ่าน Inventory ไม่สำเร็จ")
        return false
    end

    local Sword = nil

    for _, v in pairs(Inventory) do
        if v["Name"] == "Saber" then
            Sword = "Saber"
            break
        elseif v["Name"] == "Cursed Dual Katana" and Sword == nil then
            Sword = "Cursed Dual Katana"
        end
    end

    if Sword ~= nil then
        local loadSuccess = pcall(function()
            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("LoadItem", tostring(Sword))
        end)

        if loadSuccess then
            warn("[WEAPON] เปลี่ยนอาวุธเป็น " .. tostring(Sword))
        end

        return loadSuccess
    end

    warn("[WEAPON] ไม่พบ Saber หรือ Cursed Dual Katana")
    return false
end

