-- เลือกฝั่ง Pirates และรอจนกว่า Team จะถูกตั้งจริง
local function SelectPiratesTeam()
    repeat
        task.wait(0.5)

        LocalPlayerService = PlayersService.LocalPlayer

        if LocalPlayerService and LocalPlayerService.Team ~= nil then
            return true
        end

        local playerGui = LocalPlayerService and LocalPlayerService:FindFirstChild("PlayerGui")
        local mainGui = playerGui and (
            playerGui:FindFirstChild("Main (minimal)")
            or playerGui:FindFirstChild("Main")
        )
        local chooseTeam = mainGui and mainGui:FindFirstChild("ChooseTeam")

        if chooseTeam and chooseTeam.Visible then
            local container = chooseTeam:FindFirstChild("Container")
            local pirates = container and container:FindFirstChild("Pirates")
            local frame = pirates and pirates:FindFirstChild("Frame")
            local button = frame and frame:FindFirstChild("TextButton")

            if button then
                pcall(function()
                    for _, connection in pairs(getconnections(UserInputService.TouchTapInWorld)) do
                        connection:Fire()
                    end
                end)

                pcall(function()
                    local activated = false

                    for _, connection in pairs(getconnections(button.Activated)) do
                        if connection.Function then
                            connection.Function()
                            activated = true
                        elseif connection.Fire then
                            connection:Fire()
                            activated = true
                        end
                    end

                    -- สำรองสำหรับ Executor ที่รองรับ firesignal
                    if not activated and firesignal then
                        firesignal(button.Activated)
                    end
                end)
            end
        end
    until LocalPlayerService and LocalPlayerService.Team ~= nil

    return true
end

