local function CloseGameAfterTier2()
    warn("[EVO] evoTier เป็น 2 แล้ว กำลังปิดเกม...")
    task.wait(1)

    -- วิธีหลัก: ปิด Roblox ผ่าน DataModel
    local shutdownSuccess, shutdownError = pcall(function()
        game:Shutdown()
    end)

    if shutdownSuccess then
        return
    end

    warn("[EVO] game:Shutdown() ไม่สำเร็จ: " .. tostring(shutdownError))

    -- วิธีสำรองสำหรับ Executor ที่มีฟังก์ชัน shutdown
    local executorShutdown = nil

    pcall(function()
        executorShutdown = getgenv().shutdown
    end)

    if type(executorShutdown) == "function" then
        local executorSuccess = pcall(executorShutdown)

        if executorSuccess then
            return
        end
    end

    -- สำรองสุดท้าย: ตัดการเชื่อมต่อเพื่อไม่ให้สคริปต์ทำงานต่อ
    pcall(function()
        Players.LocalPlayer:Kick("[EVO] Race V2 สำเร็จแล้ว")
    end)

    while true do
        task.wait(10)
    end
end

