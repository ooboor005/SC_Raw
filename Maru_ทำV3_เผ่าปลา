local TargetRace = "Fishman"

local function GetCurrentRace()
    local player = game:GetService("Players").LocalPlayer
    local data = player:WaitForChild("Data")
    local race = data:WaitForChild("Race")
    return race.Value
end

local function EnsureTargetRace()
    local currentRace = GetCurrentRace()

    if currentRace == TargetRace then
        warn("[RACE] เผ่าปัจจุบันตรงกับเป้าหมายแล้ว: " .. tostring(TargetRace))
        return
    end

    warn(
        "[RACE] เผ่าปัจจุบันคือ "
            .. tostring(currentRace)
            .. " กำลังรีหาเผ่า "
            .. tostring(TargetRace)
    )

    repeat
        local success, rerollResult = pcall(function()
            return game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer(
                "BlackbeardReward",
                "Reroll",
                "2"
            )
        end)

        if not success then
            warn("[RACE] รีเผ่าไม่สำเร็จ กำลังลองใหม่: " .. tostring(rerollResult))
        end

        task.wait(5)
        currentRace = GetCurrentRace()
    until currentRace == TargetRace

    warn("[RACE] รีเผ่าสำเร็จแล้ว: " .. tostring(TargetRace))
end

EnsureTargetRace()

