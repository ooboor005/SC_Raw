local function RejoinForNextTier(nextTier)
    warn("[EVO] evoTier เป็น " .. tostring(nextTier) .. " แล้ว กำลัง Rejoin เกม...")

    while true do
        local success, teleportError = pcall(function()
            TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
        end)

        if success then
            return
        end

        warn("[EVO] Rejoin ไม่สำเร็จ กำลังลองใหม่: " .. tostring(teleportError))
        task.wait(3)
    end
end


