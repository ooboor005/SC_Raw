                if v:IsA("Part") and v:FindFirstChild("Part") and v:FindFirstChild("TouchInterest") then
                    if v.Part.Color == Color3.fromRGB(99, 95, 98) then
                        return false
                    end
                end
            end
            return true
        end
        return false
    end
