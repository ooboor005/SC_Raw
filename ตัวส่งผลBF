function getTableOccupant(tbl: Model) : (Player?, string?)
	for _, seatName in ipairs({ "P1", "P2" }) do
		local seat = tbl:FindFirstChild(seatName)
		if seat and seat.Occupant then
			local plr = Players:GetPlayerFromCharacter(seat.Occupant.Parent)
			if plr and plr ~= LocalPlayer then
				return plr, seatName
			end
		end
	end
	return nil, nil
end

