Connection = TradeEvent.OnClientEvent:Connect(function(action, args)
	if action == "update_state" then
		local isNewTrade = args.Trader ~= nil
		if isNewTrade then 
						local otherPlayer = LocalPlayer.UserId == args.Trader[1] and 1 or 2
			local playerNumber = otherPlayer == 1 and 2 or 1

			local FruitValueSelf = 0
			local FruitValueOther = 0

			for _, v in pairs(args.Offer[otherPlayer].Items) do 
				FruitValueOther += v.Price
			end

			for _, v in pairs(args.Offer[playerNumber].Items) do 
				FruitValueSelf += v.Price
			end
			TradeFunction:InvokeServer("accept")
			return
		end

		local playerNumber = args["Player1"].Name == LocalPlayer.Name and 1 or args["Player2"].Name == LocalPlayer.Name and 2 or nil
		if not playerNumber then
			return
		end
		local FruitValueSelf = 0
		local FruitValueOther = 0
		for i,v in pairs(args.Offer[playerNumber]) do 
			FruitValueSelf += v.Price 
		end
		for i,v in pairs(args.Offer[playerNumber == 1 and 2 or 1]) do 
			FruitValueOther += v.Price 
		end
		local minValue = math.min(FruitValueOther, FruitValueSelf)
		local maxValue = math.max(FruitValueOther, FruitValueSelf, 0.01)

		local diffPercent = (1 - (minValue / maxValue)) * 100
		local result = math.ceil(diffPercent)

		if not args.Ready[playerNumber] and result <= 40 then
			TradeFunction:InvokeServer("accept")
		end
	end
end)
